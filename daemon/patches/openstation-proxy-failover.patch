+
+// --- Kinopoisk: resolve a spoken title to a Kinopoisk film/series id ---
+// Uses ru.wikipedia (search + page props) and Wikidata P2603 (Kinopoisk film id),
+// both reachable from RU residential networks without API keys.
+
+using namespace openstation;
+
+std::string kp_http_json(const std::string& url) {
+    HttpClientRequest req;
+    req.method = "GET";
+    req.url = url;
+    req.timeout_ms = 6000;
+    req.max_body_bytes = 256 * 1024;
+    req.headers["User-Agent"] = "OpenStation/1.5.1 (SberPortal; kinopoisk deep link)";
+    req.headers["Accept"] = "application/json";
+    const HttpClientResponse r = http_perform(req);
+    if (!r.ok || r.status_code < 200 || r.status_code >= 300) {
+        LOGW("Kinopoisk", "GET %s failed: ok=%d status=%d err=%s",
+             url.c_str(), r.ok ? 1 : 0, r.status_code, r.error.c_str());
+        return std::string();
+    }
+    LOGI("Kinopoisk", "GET %s -> %d bytes", url.c_str(), static_cast<int>(r.body.size()));
+    return r.body;
+}
+
+bool kinopoisk_resolve_title(const std::string& title,
+                             std::string& out_id,
+                             std::string& out_kind,
+                             std::string& out_page) {
+    out_id.clear();
+    out_kind = "film";
+    out_page.clear();
+    if (title.empty()) return false;
+
+    // Wikidata CirrusSearch: only items that actually carry a Kinopoisk film id (P2603).
+    const std::string search_url =
+        "https://www.wikidata.org/w/api.php?action=query&format=json&list=search&srlimit=5&srsearch=" +
+        url_encode(title + " haswbstatement:P2603");
+    json::Value sv;
+    if (!json::Parser::parse(kp_http_json(search_url), sv)) return false;
+    const json::Value* sq = sv.get("query");
+    if (!sq) return false;
+    const json::Value* hits = sq->get("search");
+    if (!hits || hits->type != json::Type::Array || hits->arr_val.empty()) return false;
+
+    for (const auto& h : hits->arr_val) {
+        const json::Value* t = h.get("title");
+        if (!t) continue;
+        const std::string qid = t->as_str();
+        if (qid.empty() || qid[0] != 'Q') continue;
+        const std::string claims_url =
+            "https://www.wikidata.org/w/api.php?action=wbgetclaims&format=json"
+            "&property=P2603&entity=" + url_encode(qid);
+        json::Value cv;
+        if (!json::Parser::parse(kp_http_json(claims_url), cv)) continue;
+        std::string id;
+        if (const json::Value* claims = cv.get("claims")) {
+            if (const json::Value* arr = claims->get("P2603")) {
+                if (arr->type == json::Type::Array && !arr->arr_val.empty()) {
+                    const json::Value& claim = arr->arr_val.front();
+                    if (const json::Value* ms = claim.get("mainsnak")) {
+                        if (const json::Value* dv = ms->get("datavalue")) {
+                            if (const json::Value* val = dv->get("value")) id = val->as_str();
+                        }
+                    }
+                }
+            }
+        }
+        if (id.empty()) continue;
+        out_id = id;
+        out_page = qid;
+        LOGI("Kinopoisk", "resolved '%s' -> %s (id=%s)", title.c_str(), qid.c_str(), out_id.c_str());
+        return true;
+    }
+    LOGW("Kinopoisk", "no P2603 id for '%s'", title.c_str());
+    return false;
+}
+
+bool kinopoisk_open_deep_link(const std::string& kind, const std::string& id) {
+    if (id.empty()) return false;
+    const std::string uri = "kp://" + (kind == "series" ? std::string("series") : std::string("film")) + "/" + id;
+    return spawn_detached({"/system/bin/am", "start",
+                           "-a", "android.intent.action.VIEW",
+                           "-d", uri});
+}
